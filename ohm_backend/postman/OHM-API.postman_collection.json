    {
      "name": "User",
      "description": "Authentication, registration, session, and workspace user management endpoints for the User model.",
      "item": [
        {
          "name": "Public schema",
          "description": "Platform admin authentication; omit X-Tenant.",
          "item": [
            {
              "name": "Request root login OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"root@example.com\",\n  \"purpose\": \"login\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/otp/"
              }
            },
            {
              "name": "Root login with password",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"root@example.com\",\n  \"method\": \"password\",\n  \"password\": \"ChangeMe123!\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/login/"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const data = pm.response.json();",
                      "if (data.access) pm.collectionVariables.set('accessToken', data.access);",
                      "if (data.refresh) pm.collectionVariables.set('refreshToken', data.refresh);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Root login with OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"root@example.com\",\n  \"method\": \"otp\",\n  \"otp\": \"123456\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/login/"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const data = pm.response.json();",
                      "if (data.access) pm.collectionVariables.set('accessToken', data.access);",
                      "if (data.refresh) pm.collectionVariables.set('refreshToken', data.refresh);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Request root password reset OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"root@example.com\",\n  \"purpose\": \"password_reset\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/otp/"
              }
            },
            {
              "name": "Reset root password with OTP",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"root@example.com\",\n  \"otp\": \"123456\",\n  \"new_password\": \"NewSecurePass123!\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/password-reset/"
              }
            },
            {
              "name": "Refresh root access token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
                },
                "url": "{{baseUrl}}/api/auth/access-tokens/"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const data = pm.response.json();",
                      "if (data.access) pm.collectionVariables.set('accessToken', data.access);"
                    ]
                  }
                }
              ]
            }
          ]
        },
