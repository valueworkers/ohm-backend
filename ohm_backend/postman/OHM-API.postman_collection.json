        {
          "name": "Workspace users",
          "description": "Tenant Admin management of users in the selected tenant.",
          "item": [
            {
              "name": "List users",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Tenant",
                    "value": "{{tenantSlug}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/users/?role={{role}}&q={{search}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "users"
                  ],
                  "query": [
                    {
                      "key": "role",
                      "value": "{{role}}",
                      "disabled": true
                    },
                    {
                      "key": "q",
                      "value": "{{search}}",
                      "disabled": true
                    }
                  ]
                }
              }
            },
            {
              "name": "Create user",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Tenant",
                    "value": "{{tenantSlug}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"full_name\": \"New User\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"ChangeMe123!\",\n  \"role\": \"CUSTOMER\"\n}"
                },
                "url": "{{baseUrl}}/api/users/"
              }
            },
            {
              "name": "Get user",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Tenant",
                    "value": "{{tenantSlug}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": "{{baseUrl}}/api/users/{{userId}}/"
              }
            },
            {
              "name": "Update user",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "X-Tenant",
                    "value": "{{tenantSlug}}"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"full_name\": \"Updated Name\",\n  \"phone\": \"+919876543210\",\n  \"is_active\": true,\n  \"role\": \"CUSTOMER\"\n}"
                },
                "url": "{{baseUrl}}/api/users/{{userId}}/"
              }
            }
          ]
        }
