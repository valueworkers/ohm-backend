      "item": [
        {
          "name": "List active plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/plans/"
          }
        }
      ]
    },
    {
      "name": "TenantProvisioning",
      "description": "Provider onboarding request and review workflow endpoints.",
      "item": [
        {
          "name": "Submit onboarding request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization_name\": \"Example Clinic\",\n  \"email\": \"owner@example.com\",\n  \"contact_phone\": \"+919876543210\",\n  \"address\": \"Clinic address\",\n  \"branches\": [{\"name\": \"Main branch\", \"address\": \"Clinic address\"}],\n  \"ops_admin_email\": \"admin@example.com\",\n  \"slug\": \"example-clinic\",\n  \"custom_domain\": \"\",\n  \"wants_custom_website\": false,\n  \"requested_plan\": null\n}"
            },
            "url": "{{baseUrl}}/onboarding/requests/"
          }
        },
        {
          "name": "List my requests (platform admin sees all)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/onboarding/requests/"
          }
        },
        {
          "name": "Get request",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/onboarding/requests/{{provisioningId}}/"
          }
        },
        {
          "name": "Approve request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_notes\": \"Approved\"\n}"
            },
            "url": "{{baseUrl}}/onboarding/requests/{{provisioningId}}/approve/"
          }
        },
        {
          "name": "Reject request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_notes\": \"Reason for rejection\"\n}"
            },
            "url": "{{baseUrl}}/onboarding/requests/{{provisioningId}}/reject/"
          }
        },
        {
          "name": "Retry provisioning",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/onboarding/requests/{{provisioningId}}/retry/"
          }
        }
      ]
    },
