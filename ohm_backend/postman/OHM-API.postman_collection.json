  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Tenant API health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/",
            "description": "Tenant URL configuration; without X-Tenant this reports the public schema."
          }
        },
        {
          "name": "Public schema health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/",
            "description": "Use without X-Tenant; reports schema public."
          }
        }
      ]
    },
    {
      "name": "Plan",
