# ==============================================================================
# Django Core Settings
# ==============================================================================
DJANGO_SECRET_KEY="django-insecure-change-this-in-production"
DJANGO_DEBUG=True

# ==============================================================================
# OHM Platform & Domain Routing
# ==============================================================================
# Base domain for the platform (e.g. ohm.com in production)
OHM_BASE_DOMAIN=localhost

# Shared API Host used by web/mobile frontends (e.g. api.ohm.com in production)
OHM_API_HOST=api.ohm.localhost

# URL scheme: "http" for local development, "https" in production
OHM_URL_SCHEME=http

# Comma-separated list of root hosts mapped to the public control-plane schema
OHM_ROOT_HOSTS=127.0.0.1,localhost,api.ohm.localhost,ohm.local

# Ingress target host for tenant CNAME DNS records
OHM_EDGE_HOST=edge.example.com

# Shared secret token for internal health checks and reverse proxy (Caddy) validation
OHM_INTERNAL_TOKEN=dev-internal-token

# ==============================================================================
# PostgreSQL Database (django-tenants multi-schema)
# ==============================================================================
POSTGRES_DB=ohm-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# Redis (Cache, Session & Celery Message Broker)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Email Configuration (SMTP)
# ==============================================================================
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ohm.local

# ==============================================================================
# SMS OTP Backend (Optional)
# Dotted path to custom sender callable, e.g. "apps.accounts.services.send_sms_otp"
# ==============================================================================
OHM_SMS_OTP_BACKEND=