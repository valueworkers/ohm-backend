    {
      "key": "baseUrl",
      "value": "http://api.ohm.localhost:8000"
    },
    {
      "key": "providerSlug",
      "value": "vaishnavi-medicare"
    },
    {
      "key": "platformEmail",
      "value": "admin@example.com"
    },
    {
      "key": "platformPassword",
      "value": ""
    },
    {
      "key": "providerEmail",
      "value": "owner@example.com"
    },
    {
      "key": "providerPassword",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
