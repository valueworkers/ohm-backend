{
  "info": {
    "name": "OHM Backend API",
    "description": "Postman collection for the platform and provider APIs. Set baseUrl to the API origin (for example http://api.ohm.localhost:8000), and set providerSlug for provider requests. Use accessToken without the Bearer prefix. Public platform operations use platform credentials; provider requests require X-Provider.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
